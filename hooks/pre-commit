#!/usr/bin/env bash
set -euo pipefail

# Source cargo env for non-interactive git hook context
if [ -f "${HOME}/.cargo/env" ]; then
  . "${HOME}/.cargo/env"
fi

echo "==> Running governance checks..."
python3 .agents/tools/check_branch_name.py

# New user-reachable surfaces (CLI flag / config key / protocol) must
# land with process-level acceptance in the same commit (issue #136);
# CI re-runs this over the whole PR range.
echo "==> Running new-surface acceptance check..."
python3 .agents/tools/check_surface_e2e.py

# Skip the Rust gate when the commit touches no Rust-relevant paths;
# CI still enforces the full gate on every PR.
if git diff --cached --name-only | grep -qE '\.rs$|\.toml$|^proto/|^tests/.*\.rs$'; then
  echo "==> Running cargo fmt --check..."
  cargo fmt --check

  echo "==> Running cargo clippy..."
  # TODO: switch to 'cargo clippy -- -D warnings' once all legacy warnings are fixed.
  cargo clippy

  echo "==> Running cargo build..."
  cargo build

  echo "==> Running ratatui / session_sync tests (release)..."
  # cargo test accepts a single TESTNAME positional per invocation; the
  # filters are substring matches, so run them separately.
  cargo test --release ratatui
  cargo test --release session_sync
else
  echo "==> No Rust paths in this commit; skipping cargo gate (CI enforces it on PRs)."
fi
